# ===== Python Packages & Virtual Environments =====
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/
ENV/

# ===== PyInstaller & Build Artifacts =====
# Do not commit binaries or build folders to git
build/
dist/
*.spec
*.exe
*.bin
*.dll

# ===== IDE / OS / Office Temp Files =====
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
~$*.xlsx
~$*.xls

# ===== User Data (Prevent leakage of sensitive customer/sales data) =====
# Keep folder structures via .gitkeep, but ignore all actual data files
input_sold/*
!input_sold/.gitkeep
input_all_data/*
!input_all_data/.gitkeep
output/*
!output/.gitkeep
